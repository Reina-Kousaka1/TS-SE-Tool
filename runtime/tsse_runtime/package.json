{
  "name": "tsse-runtime-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "node -e \"require('node:fs').mkdirSync('priv/static/assets', { recursive: true })\" && esbuild assets/js/app.js --bundle --minify --target=es2022 --outfile=priv/static/assets/app.js"
  },
  "dependencies": {
    "phoenix": "1.8.17",
    "phoenix_live_view": "1.2.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
