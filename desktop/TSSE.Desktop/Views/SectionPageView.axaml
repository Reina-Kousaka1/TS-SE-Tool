<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TSSE.Desktop.Views.SectionPageView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="34,30,34,36" Spacing="22">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
          <TextBlock Text="{Binding Eyebrow}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1.5" />
          <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" />
        </StackPanel>
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,11,0,0" />
        <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,0,0" />
      </Grid>

        <Border IsVisible="{Binding IsSettings}" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SettingsStorageHeading}" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="1.2" />
          <TextBlock Text="{Binding SettingsStorageMessage}"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsSavegameExplorer}"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="10" DataContext="{Binding ProfileDemo}">
          <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BalanceLabel}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding BalanceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding BalanceLabel}" />
            <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ActionCommand}" CommandParameter="balance" />
          </Grid>
          <TextBlock Text="{Binding ExperienceLabel}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ExperienceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ExperienceLabel}" />
            <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ActionCommand}" CommandParameter="experience" />
          </Grid>
          <TextBlock Text="{Binding LevelHeading}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LevelDescription}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="ETS2" Command="{Binding ActionCommand}" CommandParameter="ets2" />
            <Button Content="ATS" Command="{Binding ActionCommand}" CommandParameter="ats" />
          </StackPanel>
          <TextBlock Text="{Binding LevelProgress}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LevelLabel}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding LevelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding LevelLabel}" />
            <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ActionCommand}" CommandParameter="level" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding UndoLabel}" Command="{Binding ActionCommand}" CommandParameter="undo" />
            <Button Content="{Binding RedoLabel}" Command="{Binding ActionCommand}" CommandParameter="redo" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PreviewLabel}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PreviewText}" FontFamily="monospace" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsVehicleStudio}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding VehicleCategoryHeading}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="1.2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="option-button" Classes.selected="{Binding IsTrucksSelected}"
                    Content="{Binding TrucksLabel}" Command="{Binding SelectVehicleCategoryCommand}" CommandParameter="Trucks" />
            <Button Classes="option-button" Classes.selected="{Binding IsTrailersSelected}"
                    Content="{Binding TrailersLabel}" Command="{Binding SelectVehicleCategoryCommand}" CommandParameter="Trailers" />
            <Button Classes="option-button" Classes.selected="{Binding IsCoachesSelected}"
                    Content="{Binding CoachesLabel}" Command="{Binding SelectVehicleCategoryCommand}" CommandParameter="Coaches" />
          </StackPanel>
          <TextBlock Text="{Binding SelectedVehicleMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsVehicleDemoVisible}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="10" DataContext="{Binding VehicleDemo}">
          <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RepairDetail}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding RepairLabel}" Command="{Binding ActionCommand}" CommandParameter="repair" />
            <Button IsVisible="{Binding CanRefuel}" Content="{Binding RefuelLabel}" Command="{Binding ActionCommand}" CommandParameter="refuel" />
          </StackPanel>
          <TextBlock Text="{Binding FieldLabel}" />
          <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" AutomationProperties.Name="{Binding FieldLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding ValueLabel}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ValueInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ValueLabel}" />
            <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ActionCommand}" CommandParameter="apply" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding UndoLabel}" Command="{Binding ActionCommand}" CommandParameter="undo" />
            <Button Content="{Binding RedoLabel}" Command="{Binding ActionCommand}" CommandParameter="redo" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PreviewLabel}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PreviewText}" FontFamily="monospace" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsJobs}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="10" DataContext="{Binding JobDemo}">
          <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CargoLabel}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Cargo}" />
          <TextBlock Text="{Binding UnitsLabel}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding UnitsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding UnitsLabel}" />
            <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ActionCommand}" CommandParameter="apply" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding UndoLabel}" Command="{Binding ActionCommand}" CommandParameter="undo" />
            <Button Content="{Binding RedoLabel}" Command="{Binding ActionCommand}" CommandParameter="redo" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PreviewLabel}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PreviewText}" FontFamily="monospace" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsEconomyIntelligence}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding AnalyticsWindowHeading}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="1.2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="option-button" Classes.selected="{Binding IsSevenDaysSelected}"
                    Content="{Binding SevenDaysLabel}" Command="{Binding SelectAnalyticsWindowCommand}" CommandParameter="7" />
            <Button Classes="option-button" Classes.selected="{Binding IsThirtyDaysSelected}"
                    Content="{Binding ThirtyDaysLabel}" Command="{Binding SelectAnalyticsWindowCommand}" CommandParameter="30" />
            <TextBlock Text="{Binding SelectedWindowLabel}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding AnalyticsNotice}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding StatusCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="286" MinHeight="136" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="17" Margin="0,0,12,12">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="1" />
                <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="i" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EmptyStateMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
